[
  {
    "name": "restart-service",
    "symptom": "process_missing",
    "precondition": "test -f \"{{.Dir}}/toyd.conf\"",
    "apply": "nohup \"{{.Toyd}}\" -config \"{{.Dir}}/toyd.conf\" -pidfile \"{{.Dir}}/toyd.pid\" >>\"{{.Dir}}/toyd.log\" 2>&1 &",
    "done_test": "health_ok",
    "within": "10s",
    "undo": "kill $(cat \"{{.Dir}}/toyd.pid\") 2>/dev/null || true",
    "touches": ["toyd.pid", "toyd.log"]
  },
  {
    "name": "restore-config",
    "symptom": "health_failing",
    "precondition": "test -f \"{{.Dir}}/toyd.conf.good\"",
    "apply": "cp \"{{.Dir}}/toyd.conf\" \"{{.Dir}}/toyd.conf.pre\" && cp \"{{.Dir}}/toyd.conf.good\" \"{{.Dir}}/toyd.conf\"",
    "done_test": "health_ok",
    "within": "10s",
    "undo": "cp \"{{.Dir}}/toyd.conf.pre\" \"{{.Dir}}/toyd.conf\"",
    "touches": ["toyd.conf", "toyd.conf.pre"]
  }
]
